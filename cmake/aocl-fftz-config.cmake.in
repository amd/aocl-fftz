# AOCL-FFTZ CMake Package Configuration File
#
# Provides the imported target ``aocl-fftz::aocl_fftz`` for the AOCL-FFTZ library.
#
# Usage:
#   find_package(aocl-fftz REQUIRED)
#   target_link_libraries(myapp PRIVATE aocl-fftz::aocl_fftz)
#

@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
if(@AOCL_FFTZ_REQUIRES_OPENMP@)
   find_dependency(OpenMP REQUIRED)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/aocl-fftz-targets.cmake")
