# pkg-config file for FFTW3f (single) wrapper - AOCL-FFTZ (generated by CMake)
# Used by build systems (e.g. configure, Meson) to get compiler/linker flags.
# This provides only the FFTW3f (single-precision) interface; use fftw3.pc for double precision.

prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${prefix}/@DEST_LIB_PATH@
includedir=${prefix}/@DEST_INC_PATH@

Name: FFTW3f
Description: FFTW3 single-precision interface (AOCL-FFTZ wrapper)
Version: @FFTZ_VERSION@
Libs: -L${libdir} -lfftw3f
Libs.private: -laocl_fftz @FFTZ_LIBS_PRIVATE@
Cflags: -I${includedir}
