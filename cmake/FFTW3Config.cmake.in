#
# FFTW3-compatible CMake config for the AOCL-FFTZ FFTW wrapper.
# find_package(FFTW3) will find this wrapper so apps using FFTW APIs link to AOCL-FFTZ.
#
# Usage (modern, preferred):
#   find_package(FFTW3 REQUIRED)
#   target_link_libraries(target_app PRIVATE FFTW3::fftw3)       # double precision
#   target_link_libraries(target_app PRIVATE FFTW3::fftw3f)     # float (alias)
#   target_link_libraries(target_app PRIVATE FFTW3::fftw3_omp)   # double, OpenMP name (alias)
#   target_link_libraries(target_app PRIVATE FFTW3::fftw3f_omp)  # float, OpenMP name (alias)
#

@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(aocl-fftz REQUIRED)

include("${CMAKE_CURRENT_LIST_DIR}/FFTW3Targets.cmake")

# We ship one library that implements both double (fftw3) and float (fftw3f) FFTW APIs.
# Add aliases so code that links -lfftw3f, -lfftw3_omp, -lfftw3f_omp still works.
if(NOT TARGET FFTW3::fftw3f AND TARGET FFTW3::fftw3)
  add_library(FFTW3::fftw3f ALIAS FFTW3::fftw3)
endif()
if(NOT TARGET FFTW3::fftw3_omp AND TARGET FFTW3::fftw3)
  add_library(FFTW3::fftw3_omp ALIAS FFTW3::fftw3)
endif()
if(NOT TARGET FFTW3::fftw3f_omp AND TARGET FFTW3::fftw3)
  add_library(FFTW3::fftw3f_omp ALIAS FFTW3::fftw3)
endif()

# Legacy variables for projects that use FFTW3_LIBRARIES / FFTW3_INCLUDE_DIRS instead of targets.
if(TARGET FFTW3::fftw3)
  set(FFTW3_LIBRARIES FFTW3::fftw3)
  set(FFTW3_INCLUDE_DIRS "${PACKAGE_PREFIX_DIR}/include")
  set(FFTW3_LIBRARY_DIRS "${PACKAGE_PREFIX_DIR}/lib")
endif()
