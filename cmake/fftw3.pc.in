# pkg-config file for FFTW3 (double) wrapper - AOCL-FFTZ (generated by CMake)
# Used by build systems (e.g. configure, Meson) to get compiler/linker flags.
# This provides only the FFTW3 (double) interface; use fftw3f.pc for single precision.

prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${prefix}/@DEST_LIB_PATH@
includedir=${prefix}/@DEST_INC_PATH@

Name: FFTW3
Description: FFTW3 double-precision interface (AOCL-FFTZ wrapper)
Version: @FFTZ_VERSION@
Libs: -L${libdir} -lfftw3
Libs.private: @FFTZ_LIBS@ @FFTZ_LIBS_PRIVATE@
Cflags: -I${includedir}
