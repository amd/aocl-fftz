# pkg-config file for AOCL-FFTZ (generated by CMake)
# Used by build systems (e.g. configure, Meson) to get compiler/linker flags.
# Build-dependent options (e.g. OpenMP when multi-threading is enabled) are only
# in Libs.private, populated by CMake. Libs and Cflags do not include OpenMP.

prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${prefix}/@DEST_LIB_PATH@
includedir=${prefix}/@DEST_INC_PATH@

Name: AOCL-FFTZ
Description: @FFTZ_DESCRIPTION@
Version: @FFTZ_VERSION@
Libs: -L${libdir} @FFTZ_LIBS@
Libs.private: @FFTZ_LIBS_PRIVATE@
Cflags: -I${includedir}
