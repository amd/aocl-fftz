# pkg-config file for FFTW3f OpenMP (single) wrapper - AOCL-FFTZ (generated by CMake)
# Used by build systems (e.g. configure, Meson) to get compiler/linker flags.
# This provides the FFTW3 single-precision OpenMP interface name; use fftw3_omp.pc for double precision.

prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${prefix}/@DEST_LIB_PATH@
includedir=${prefix}/@DEST_INC_PATH@

Name: FFTW3f_omp
Description: FFTW3 single-precision OpenMP interface (AOCL-FFTZ wrapper)
Version: @FFTZ_VERSION@
Libs: -L${libdir} -lfftw3f_omp
Libs.private: @FFTZ_LIBS@ @FFTZ_LIBS_PRIVATE@
Cflags: -I${includedir}
