# pkg-config file for FFTW3 OpenMP (double) wrapper - AOCL-FFTZ (generated by CMake)
# Used by build systems (e.g. configure, Meson) to get compiler/linker flags.
# This provides the FFTW3 double-precision OpenMP interface name; use fftw3f_omp.pc for single precision.

prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${prefix}/@DEST_LIB_PATH@
includedir=${prefix}/@DEST_INC_PATH@

Name: FFTW3_omp
Description: FFTW3 double-precision OpenMP interface (AOCL-FFTZ wrapper)
Version: @FFTZ_VERSION@
Libs: -L${libdir} -lfftw3_omp
Libs.private: @FFTZ_LIBS@ @FFTZ_LIBS_PRIVATE@
Cflags: -I${includedir}
